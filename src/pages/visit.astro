---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { contact, hours, site } from '../data/site';

import shopfront from '../assets/shopfront.jpg';
import counterCornish from '../assets/counter-cornish.jpg';

const travel = [
  {
    title: 'Underground & rail',
    body: 'London Bridge is a two-minute walk - Jubilee and Northern lines, plus the national rail terminal. Come out of the Borough High Street exit and follow Southwark Street.',
  },
  {
    title: 'Bus',
    body: 'Routes stop on Southwark Street, Borough High Street and at London Bridge Station, all of which put you within a few minutes of the market.',
  },
  {
    title: 'By bike',
    body: 'Cycle hire docks and bike racks sit on both Southwark Street and Park Street, right by the market entrances.',
  },
  {
    title: 'Parking',
    body: 'There is no market parking, but several car parks are within walking distance - Union Car Parks and the Snowfields NCP are the usual choices.',
  },
];
---

<BaseLayout
  title="Visit Us"
  description="Furness Fish Market, 8 Southwark Street, Borough Market, London SE1 1TL. Open Tuesday to Sunday. Two minutes from London Bridge."
  transparentHeader
>
  <Hero
    image={shopfront}
    alt="The Furness Fish Market stall front in Borough Market"
    eyebrow="Visit us"
    title="8 Southwark Street"
    lede="On the corner of Borough Market, two minutes from London Bridge, under the railway arches. You will smell the paella before you see the sign."
  />

  <!-- ------------------------------------------------------ hours & map -- -->
  <section class="section">
    <div class="wrap">
      <div class="visit__grid">
        <div data-reveal>
          <p class="eyebrow">Where</p>
          <h2>Find the stall</h2>
          <address class="visit__address">
            {contact.addressLines.map((line) => <span>{line}<br /></span>)}
          </address>
          <div class="btn-row">
            <a class="btn btn--solid" href={contact.mapsUrl} target="_blank" rel="noopener noreferrer">
              Open in maps
            </a>
          </div>
        </div>

        <div data-reveal data-reveal-delay="120">
          <p class="eyebrow">When</p>
          <h2>Opening hours</h2>
          <ul class="visit__hours">
            {
              hours.map((row) => (
                <li class:list={[row.closed && 'is-closed']}>
                  <span>{row.day}</span>
                  <span>{row.time}</span>
                </li>
              ))
            }
          </ul>
          <p class="muted visit__note">
            Come early for the turbot and the Dover sole - the best of the day boat rarely lasts past
            lunchtime on a Saturday.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------------- travel -- -->
  <section class="section section--paper">
    <div class="wrap">
      <div class="visit__head" data-reveal>
        <p class="eyebrow">Getting here</p>
        <h2>It is easier than you think</h2>
      </div>

      <ul class="visit__travel">
        {
          travel.map((item, index) => (
            <li data-reveal data-reveal-delay={(index % 2) * 90}>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- --------------------------------------------------------- contact -- -->
  <section class="section section--ink" id="enquiries">
    <div class="wrap">
      <div class="visit__contact">
        <div data-reveal>
          <p class="eyebrow">Get in touch</p>
          <h2>Talk to us before you come</h2>
          <p class="muted">
            Want something specific held back? Cooking for twenty? After a wholesale order, oysters
            for a party, or a tin of caviar you would rather we set aside? Send it over and a person
            will answer it.
          </p>

          <p class="eyebrow visit__socials-head">Follow along</p>
          <ul class="visit__socials">
            <li>
              <a href={site.instagram.market.url} target="_blank" rel="noopener noreferrer">
                <span class="visit__handle">@{site.instagram.market.handle}</span>
                <span class="visit__social-note">The counter, the catch, the queue</span>
              </a>
            </li>
            <li>
              <a href={site.instagram.oysterBar.url} target="_blank" rel="noopener noreferrer">
                <span class="visit__handle">@{site.instagram.oysterBar.handle}</span>
                <span class="visit__social-note">The Oyster Boat, the board, the shucking</span>
              </a>
            </li>
          </ul>
        </div>

        <div data-reveal data-reveal-delay="120">
          <EnquiryForm />
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    image={counterCornish}
    alt=""
    eyebrow="See you Tuesday"
    title="Borough Market. The corner with the boat on the sign."
    position="center 30%"
  >
    <div class="btn-row">
      <a class="btn btn--light" href="/the-counter/">See the counter</a>
      <a class="btn btn--light" href="/oyster-bar/">The Oyster Boat</a>
    </div>
  </CtaBand>
</BaseLayout>

<style>
  .visit__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .visit__address {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-style: normal;
    line-height: 2;
  }

  .visit__hours {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .visit__hours li {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 0;
    padding: 0.75em 0;
    border-bottom: 1px solid var(--line);
    font-size: 1rem;
  }
  .visit__hours li span:first-child { font-weight: 400; }
  .visit__hours li span:last-child { color: var(--muted); }
  .visit__hours .is-closed span { color: var(--muted); opacity: 0.7; }
  .visit__note { margin-top: 1.5rem; max-width: 42ch; font-size: 0.95rem; }

  .visit__contact {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .visit__socials-head { margin-top: 2.5rem; }

  .visit__head {
    max-width: 46ch;
    margin-bottom: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .visit__travel {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 3.5vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .visit__travel li {
    margin: 0;
    padding-top: 1.35rem;
    border-top: 1px solid var(--line);
  }
  .visit__travel h3 { margin-bottom: 0.6rem; }
  .visit__travel p {
    margin: 0;
    max-width: 46ch;
    font-size: 0.97rem;
    color: var(--muted);
  }

  .visit__email {
    margin: 1.75rem 0 0;
    font-family: var(--display);
    font-size: clamp(1.3rem, 1.05rem + 1.1vw, 1.85rem);
  }
  .visit__email a {
    color: var(--paper);
    text-decoration: none;
    border-bottom: 1px solid var(--brass);
    padding-bottom: 0.12em;
    overflow-wrap: anywhere;
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .visit__email a:hover,
  .visit__email a:focus-visible { color: var(--brass-2); border-color: var(--brass-2); }

  .visit__socials {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .visit__socials li {
    margin: 0;
    border-top: 1px solid var(--line-on-dark);
  }
  .visit__socials li:last-child { border-bottom: 1px solid var(--line-on-dark); }
  .visit__socials a {
    display: block;
    padding: 1.25rem 0;
    text-decoration: none;
    transition: opacity 0.3s var(--ease);
  }
  .visit__socials a:hover,
  .visit__socials a:focus-visible { opacity: 0.75; }
  .visit__handle {
    display: block;
    font-family: var(--display);
    font-size: clamp(1.3rem, 1.1rem + 0.85vw, 1.7rem);
    color: var(--paper);
  }
  .visit__social-note {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    color: var(--muted-on-dark);
  }

  @media (min-width: 52rem) {
    .visit__grid { grid-template-columns: 1fr 1fr; }
    .visit__contact { grid-template-columns: 0.85fr 1.15fr; }
    .visit__travel { grid-template-columns: repeat(2, 1fr); }
  }
</style>
