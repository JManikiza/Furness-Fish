---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Feature from '../components/Feature.astro';
import CatchList from '../components/CatchList.astro';
import CtaBand from '../components/CtaBand.astro';
import VideoBlock from '../components/VideoBlock.astro';
import { oysters as oysterVarieties, site } from '../data/site';

import oystersImg from '../assets/oysters.jpg';
import oysterBarBoat from '../assets/oyster-bar-boat.jpg';
import carlingfordOyster from '../assets/carlingford-oyster.jpg';
import seaUrchins from '../assets/sea-urchins.jpg';
import scallopShellsOpen from '../assets/scallop-shells-open.jpg';
import oysterBarQueue from '../assets/oyster-bar-queue.jpg';
---

<BaseLayout
  title="The Oyster Boat"
  description="Louët-Feisser and Alanna oysters from Carlingford Lough, Connemaras, Gillardeau, Ostra Regal and Devon XXL, shucked to order at the Furness Oyster Bar in Borough Market."
  transparentHeader
>
  <Hero
    image={oystersImg}
    alt="Oysters on the half shell, packed on ice at the Furness Oyster Bar"
    eyebrow="The Oyster Boat"
    title="Shucked while you stand there"
    lede="Nine things on the board most days, a knife that never stops, and a cold glass to go with it. In the middle of Borough Market, standing up."
  />

  <section class="section section--tight">
    <div class="wrap wrap--mid" data-reveal>
      <p class="eyebrow">The idea</p>
      <p class="lede">
        There is no table. There is no booking. You walk up to the Boat, you say roughly what you
        like, whether that is briny, creamy, big, small, or "I have never had one and I am nervous",
        and ninety seconds later you are holding a shell.
      </p>
      <p class="muted" style="margin-top:1.5rem">
        Darius, Fred and Jack run it. Between them they shuck several thousand a week, and they have
        talked more first-timers through their first oyster than they can count. Nobody here is going
        to make you feel silly for asking what a Louët-Feisser is.
      </p>
    </div>
  </section>

  <!-- ------------------------------------------------------------ board -- -->
  <section class="section section--paper">
    <div class="wrap">
      <div class="oyster__head" data-reveal>
        <p class="eyebrow">On the board</p>
        <h2>What we are shucking</h2>
        <p class="muted oyster__blurb">
          Mostly Irish, because that is where the best of it is coming from right now. The board
          rotates with the season and with what the beds are giving up, so ask what is best today.
        </p>
      </div>
      <CatchList items={oysterVarieties} />
    </div>
  </section>

  <Feature
    image={oysterBarBoat}
    alt="The Furness Oyster Bar: a wooden boat filled with ice and oysters, lit by hanging lanterns, with the team shucking behind it"
    eyebrow="Where to find it"
    title="Look for the boat full of ice"
  >
    <p>
      The bar is an actual boat. A wooden hull packed end to end with crushed ice, oysters, urchins
      and lemons, moored at the corner of the stall under a run of hanging lanterns and a row of
      painted signs.
    </p>
    <p>
      Walk up to the side of it, point at what you want, and watch it get opened in front of you.
      There is nowhere to sit and that is deliberate: it keeps the ice moving and the queue talking.
    </p>
  </Feature>

  <VideoBlock
    src="/video/oyster-bar.mp4"
    poster="/video/oyster-bar-poster.jpg"
    eyebrow="Forty-five minutes of an ordinary day"
    title="This is what it looks like"
    aspect="640 / 992"
    maxWidth="24rem"
  >
    <p>
      Three quarters of an hour at the Boat, squeezed into forty-two seconds. Filmed over the
      counter on a normal trading day.
    </p>
  </VideoBlock>

  <Feature
    image={carlingfordOyster}
    alt="A Carlingford Louët-Feisser oyster freshly opened on the half shell"
    eyebrow="Our house oyster"
    title="Carlingford Lough, and the family who farm it"
    flip
  >
    <p>
      The <strong>Louët-Feissers</strong> have been growing oysters in Carlingford Lough since 1974.
      Theirs are raised in suspended baskets, which is slower and fussier than laying them on the bed
      but produces a deeper cup, a stronger shell and that pearly white enamel inside.
    </p>
    <p>
      Alongside them we carry the <strong>Alanna</strong>, the newest oyster in their range and a
      world exclusive to this counter. It is a smaller, cocktail-size shell named after the Irish
      term of endearment and after the eldest Louët-Feisser daughter. Two mouthfuls, and the best
      possible place to start if you have never had one.
    </p>
  </Feature>

  <Feature
    image={seaUrchins}
    alt="A row of sea urchins packed together on ice"
    eyebrow="Beyond oysters"
    title="Urchins, caviar, and whatever else is worth opening"
  >
    <p>
      Sea urchins from Iceland and Orkney, cut open in front of you and handed over with a spoon.
      Cold northern water gives them a dense, sweet roe and a mineral finish that goes on for a while.
    </p>
    <p>
      A proper caviar selection lives at this end of the counter too, and the three of them will
      happily walk you through the tins: what is worth the money, what is worth the money
      <em>today</em>, and what to eat it with. No blinis-and-cream lecture unless you want one.
    </p>
  </Feature>

  <!-- ----------------------------------------------------------- drink -- -->
  <section class="section section--ink">
    <div class="wrap wrap--mid" data-reveal>
      <p class="eyebrow eyebrow--center">What to drink</p>
      <blockquote class="pull oyster__quote">
        "A cold, mean, unfashionable white, and no ice in it."
      </blockquote>
      <p class="muted oyster__quote-note">
        Muscadet. Picpoul. Chablis if you are feeling flush. Or a Guinness, which is not a joke and
        never has been. Borough Market has all of it within thirty seconds' walk, and nobody minds
        which one you come back holding.
      </p>
    </div>
  </section>

  <CtaBand
    image={oysterBarQueue}
    alt=""
    eyebrow="Follow the bar"
    title={`@${site.instagram.oysterBar.handle}`}
    position="center 30%"
  >
    <p class="lede">
      What is on the board today, what just came in, and the occasional video of Fred opening a
      Carlingford faster than seems reasonable.
    </p>
    <div class="btn-row">
      <a class="btn btn--light" href={site.instagram.oysterBar.url} target="_blank" rel="noopener noreferrer">
        Follow on Instagram
      </a>
      <a class="btn btn--light" href="/visit/">Find the stall</a>
    </div>
  </CtaBand>

  <Feature
    image={scallopShellsOpen}
    alt="Hand-dived scallops opened in the shell with the coral still attached"
    eyebrow="Parties &amp; events"
    title="We will bring the Boat to you"
    flip
  >
    <p>
      We shuck at private parties, launches and weddings. A table of ice, someone behind it with a
      knife, and a great many oysters. It works considerably better than a canape tray.
    </p>
    <p>
      Tell us your date, rough numbers and where you are on the
      <a href="/visit/">enquiry form</a>, and we will come back to you with what it would take.
    </p>
  </Feature>
</BaseLayout>

<style>
  .oyster__head {
    max-width: 52ch;
    margin-bottom: clamp(2.25rem, 4.5vw, 3.5rem);
  }
  .oyster__blurb { margin-top: 1rem; }

  .oyster__quote {
    max-width: 24ch;
    margin: 0 auto;
    text-align: center;
    color: var(--paper);
  }
  .oyster__quote-note {
    max-width: 54ch;
    margin: 2rem auto 0;
    text-align: center;
  }
</style>
