---
import type { Catch } from '../data/site';

interface Props {
  items: readonly Catch[];
  /** Two columns on desktop rather than one wide column. */
  columns?: 1 | 2;
}
const { items, columns = 2 } = Astro.props;
---

<ul class:list={['catch', columns === 2 && 'catch--two']}>
  {
    items.map((item) => (
      <li class="catch__item" data-reveal>
        <div class="catch__head">
          <h3 class="catch__name">{item.name}</h3>
          <p class="catch__origin">{item.origin}</p>
        </div>
        <p class="catch__note">{item.note}</p>
      </li>
    ))
  }
</ul>

<style>
  .catch {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .catch__item {
    margin: 0;
    padding: clamp(1.35rem, 2.4vw, 1.9rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .catch__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    margin-bottom: 0.5rem;
  }

  .catch__name {
    margin: 0;
    font-size: clamp(1.25rem, 1.1rem + 0.65vw, 1.6rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .catch__origin {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .catch__note {
    margin: 0;
    max-width: 56ch;
    font-size: 0.96rem;
    line-height: 1.72;
    color: var(--muted);
  }

  /* Masonry-free two-column: columns keep the hairlines tidy and reflow
     naturally without any JS. */
  @media (min-width: 56rem) {
    .catch--two {
      column-count: 2;
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
      border-top: 0;
    }
    .catch--two .catch__item {
      break-inside: avoid;
      border-top: 1px solid var(--line);
      border-bottom: 0;
    }
  }
</style>
