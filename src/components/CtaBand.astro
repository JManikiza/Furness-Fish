---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt?: string;
  eyebrow?: string;
  title: string;
  position?: string;
}
const { image, alt = '', eyebrow, title, position = 'center' } = Astro.props;
---

<section class="band">
  <div class="band__media">
    <Image
      src={image}
      alt={alt}
      widths={[640, 960, 1440, 2000]}
      sizes="100vw"
      loading="lazy"
      style={`object-position:${position}`}
    />
  </div>

  <div class="wrap wrap--mid band__inner" data-reveal>
    {eyebrow && <p class="eyebrow eyebrow--center">{eyebrow}</p>}
    <h2 class="band__title">{title}</h2>
    <slot />
  </div>
</section>

<style>
  .band {
    position: relative;
    isolation: isolate;
    padding-block: clamp(4.5rem, 12vw, 8.5rem);
    background: var(--ink);
    color: var(--paper);
    text-align: center;
    overflow: hidden;
  }

  .band__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .band__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .band__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(7, 28, 39, 0.68);
  }

  .band__inner { position: relative; }

  .band__title {
    max-width: 20ch;
    margin-inline: auto;
    color: #fff;
    font-weight: 400;
  }

  .band :global(p) { color: rgba(255, 255, 255, 0.86); }
  .band :global(.btn-row) { justify-content: center; }
  .band :global(.lede) {
    max-width: 52ch;
    margin-inline: auto;
    color: rgba(255, 255, 255, 0.9);
  }
</style>
