---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  /** 'full' = landing hero, 'page' = shorter inner-page banner. */
  variant?: 'full' | 'page';
  /** Nudges the visible part of the crop on tall/narrow screens. */
  position?: string;
}

const { image, alt, eyebrow, title, lede, variant = 'page', position = 'center' } = Astro.props;
const hasActions = Astro.slots.has('default');
---

<section class:list={['hero', `hero--${variant}`]}>
  <div class="hero__media">
    <Image
      src={image}
      alt={alt}
      widths={[640, 960, 1280, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      style={`object-position:${position}`}
    />
  </div>

  <div class="hero__inner wrap">
    {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
    <h1 class="hero__title">{title}</h1>
    {lede && <p class="hero__lede">{lede}</p>}
    {hasActions && <div class="btn-row"><slot /></div>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    isolation: isolate;
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
  }

  /* Height is viewport-relative but capped, so a 4K monitor doesn't get an
     absurd hero and a short laptop still sees the headline without scrolling. */
  .hero--full {
    min-height: clamp(30rem, 92svh, 54rem);
    padding-block: clamp(7rem, 16vh, 11rem) clamp(3.5rem, 9vh, 6.5rem);
  }
  .hero--page {
    min-height: clamp(21rem, 56svh, 32rem);
    padding-block: clamp(7rem, 14vh, 9rem) clamp(2.75rem, 6vh, 4.5rem);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Two-stop scrim: keeps text legible without flattening the photograph. */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(7, 28, 39, 0.92) 0%, rgba(7, 28, 39, 0.55) 38%, rgba(7, 28, 39, 0.12) 72%, rgba(7, 28, 39, 0.3) 100%);
  }

  .hero__inner { position: relative; width: 100%; }

  .hero__eyebrow {
    margin: 0 0 1.35rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--brass-2);
  }

  .hero__title {
    max-width: 17ch;
    margin: 0;
    color: #fff;
    font-weight: 400;
    text-shadow: 0 1px 24px rgba(7, 28, 39, 0.4);
  }
  .hero--page .hero__title { max-width: 20ch; }

  .hero__lede {
    max-width: 46ch;
    margin: 1.5rem 0 0;
    font-size: clamp(1.02rem, 0.95rem + 0.42vw, 1.24rem);
    line-height: 1.72;
    color: rgba(255, 255, 255, 0.88);
  }
</style>
