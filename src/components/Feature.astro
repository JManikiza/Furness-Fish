---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  /** Put the image on the right instead of the left. */
  flip?: boolean;
  /** Small caption printed under the image. */
  caption?: string;
}

const { image, alt, eyebrow, title, flip = false, caption } = Astro.props;
---

<section class="feature section">
  <div class="wrap">
    <div class:list={['feature__grid', flip && 'feature__grid--flip']}>
      <figure class="feature__media" data-reveal>
        <Image
          src={image}
          alt={alt}
          widths={[480, 760, 1100, 1500]}
          sizes="(min-width: 60rem) 48vw, 92vw"
          loading="lazy"
        />
        {caption && <figcaption>{caption}</figcaption>}
      </figure>

      <div class="feature__body" data-reveal data-reveal-delay="120">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2>{title}</h2>
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .feature__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .feature__media { margin: 0; }
  .feature__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .feature__media figcaption {
    margin-top: 0.9rem;
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (min-width: 60rem) {
    .feature__grid { grid-template-columns: 1fr 1fr; }
    .feature__grid--flip .feature__media { order: 2; }
    .feature__media :global(img) { aspect-ratio: 5 / 6; }
  }
</style>
