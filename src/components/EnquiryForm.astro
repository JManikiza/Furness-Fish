---
import { contact } from '../data/site';
import { withBase } from '../lib/paths';

/**
 * Enquiry form, posted to Web3Forms.
 *
 * It works three ways, in descending order of niceness:
 *   1. With JS, it submits by fetch and reports success inline without a reload.
 *   2. Without JS, the plain form POST still reaches Web3Forms, which redirects
 *      back to the thank-you page set in the hidden `redirect` field.
 *   3. With no access key configured, no form is rendered at all - the email
 *      address is shown instead, so nothing on the page pretends to work.
 *
 * Set the key in src/data/site.ts (contact.formAccessKey).
 */

const hasKey = contact.formAccessKey.length > 0;
// Absolute URL, because Web3Forms redirects the no-JS fallback to it.
const thankYouUrl = new URL(withBase('/thank-you/'), Astro.site).href;
const enquiryTypes = [
  'General question',
  'Reserve something from the counter',
  'Oysters for a party or event',
  'Restaurant or wholesale supply',
  'Something else',
];
---

{
  hasKey ? (
    <form class="enquiry" action="https://api.web3forms.com/submit" method="POST" data-enquiry>
      <input type="hidden" name="access_key" value={contact.formAccessKey} />
      <input type="hidden" name="subject" value="New enquiry from furnessfishmarkets.com" />
      <input type="hidden" name="from_name" value="Furness Fish Market website" />
      <input type="hidden" name="redirect" value={thankYouUrl} />

      {/* Honeypot: real people never see it, bots fill it in and get dropped. */}
      <label class="enquiry__hp">
        Do not fill this in
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
      </label>

      <div class="enquiry__row">
        <div class="field">
          <label for="enq-name">Your name</label>
          <input id="enq-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="enq-email">Email</label>
          <input id="enq-email" name="email" type="email" autocomplete="email" required />
        </div>
      </div>

      <div class="enquiry__row">
        <div class="field">
          <label for="enq-phone">Phone <span class="field__opt">(optional)</span></label>
          <input id="enq-phone" name="phone" type="tel" autocomplete="tel" />
        </div>
        <div class="field">
          <label for="enq-type">What is it about?</label>
          <select id="enq-type" name="enquiry_type">
            {enquiryTypes.map((type) => <option value={type}>{type}</option>)}
          </select>
        </div>
      </div>

      <div class="field">
        <label for="enq-message">Message</label>
        <textarea id="enq-message" name="message" rows="5" required></textarea>
      </div>

      <div class="enquiry__actions">
        <button class="btn btn--light" type="submit" data-enquiry-submit>Send enquiry</button>
        <p class="enquiry__status" role="status" aria-live="polite" data-enquiry-status></p>
      </div>

      <p class="enquiry__small">
        Goes straight to <a href={`mailto:${contact.email}`}>{contact.email}</a>. We answer most
        things within a day, though not on a Monday.
      </p>
    </form>
  ) : (
    <div class="enquiry-fallback">
      <p class="muted">
        Email is the quickest way to reach the counter, and it is a person who answers it.
      </p>
      <p class="enquiry-fallback__email">
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </p>
      <p class="enquiry__small">
        A contact form is built and ready on this page. It switches on the moment a free Web3Forms
        access key is added to <code>src/data/site.ts</code>.
      </p>
    </div>
  )
}

<style>
  .enquiry { margin: 0; }

  .enquiry__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 1.5rem;
  }

  .field { margin-bottom: 1.6rem; }

  .field label {
    display: block;
    margin-bottom: 0.55rem;
    font-family: var(--body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--brass-2);
  }
  .field__opt {
    letter-spacing: 0.1em;
    text-transform: none;
    color: var(--muted-on-dark);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.75rem 0;
    border: 0;
    border-bottom: 1px solid var(--line-on-dark);
    border-radius: 0;
    background: transparent;
    color: var(--paper);
    font-family: var(--body);
    font-size: 1rem;
    font-weight: 300;
    transition: border-color 0.3s var(--ease);
  }
  .field textarea { resize: vertical; line-height: 1.7; }

  .field input:hover,
  .field select:hover,
  .field textarea:hover { border-bottom-color: rgba(255, 255, 255, 0.4); }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--brass-2);
  }
  /* Keyboard users still get a visible ring; the border alone is not enough. */
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--brass-2);
    outline-offset: 4px;
  }

  .field select { appearance: none; cursor: pointer; }
  .field select option { background: var(--ink); color: var(--paper); }

  .enquiry__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 0.5rem;
  }

  .enquiry__status {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted-on-dark);
  }
  .enquiry__status[data-state='ok'] { color: var(--brass-2); }
  .enquiry__status[data-state='error'] { color: #ff9b8a; }

  .enquiry__small {
    margin: 1.75rem 0 0;
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--muted-on-dark);
  }
  .enquiry__small a { color: var(--bone); }

  /* Visually hidden, but not display:none - bots read the DOM, not the CSS. */
  .enquiry__hp {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .enquiry-fallback__email {
    margin: 1.5rem 0 0;
    font-family: var(--display);
    font-size: clamp(1.3rem, 1.05rem + 1.1vw, 1.85rem);
  }
  .enquiry-fallback__email a {
    color: var(--paper);
    text-decoration: none;
    border-bottom: 1px solid var(--brass);
    padding-bottom: 0.12em;
    overflow-wrap: anywhere;
  }
  .enquiry-fallback code {
    font-size: 0.92em;
    color: var(--bone);
  }

  @media (min-width: 40rem) {
    .enquiry__row { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
  const status = document.querySelector<HTMLParagraphElement>('[data-enquiry-status]');
  const submit = document.querySelector<HTMLButtonElement>('[data-enquiry-submit]');

  if (form && status && submit) {
    const setStatus = (text: string, state: 'busy' | 'ok' | 'error') => {
      status.textContent = text;
      status.dataset.state = state;
    };

    form.addEventListener('submit', async (event) => {
      // Let the browser handle its own validation messages first.
      if (!form.reportValidity()) return;

      event.preventDefault();
      submit.disabled = true;
      setStatus('Sending...', 'busy');

      try {
        const payload = Object.fromEntries(new FormData(form).entries());
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json();

        if (response.ok && result.success) {
          form.reset();
          setStatus('Thank you. That has reached the counter, and someone will come back to you.', 'ok');
        } else {
          setStatus(
            `Something went wrong at our end. Please email ${form.dataset.fallback ?? 'furnessfishmarket@gmail.com'} instead.`,
            'error',
          );
        }
      } catch {
        setStatus(
          'That did not send - you may be offline. Please try again, or email furnessfishmarket@gmail.com.',
          'error',
        );
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
